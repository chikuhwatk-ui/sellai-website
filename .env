# Default: the coming-soon page. Set VITE_SITE_MODE=full on Railway (or run npm run dev:full) for the full site.
VITE_SITE_MODE=coming-soon
# Optional. Set on Railway to let /?preview=<key> unlock the full site for one browser tab.
# VITE_PREVIEW_KEY=
# Optional. A POST endpoint (e.g. Formspree) for the waitlist form; without it the form composes an email.
# VITE_WAITLIST_ENDPOINT=
# Optional. International format digits only, e.g. 2637XXXXXXXX. Shows a WhatsApp link when set.
# VITE_WHATSAPP_NUMBER=
